# Template file for 'wine-pure-git'
pkgname=wine-pure-git
version=11.14
revision=1
_commit=${version}
_staging_commit=v${version}
short_desc="Bleeding-edge Wine build (Staging, WoW64, Wayland)"
maintainer="Terromur <terromuroz@proton.me>"
license="LGPL-2.1-or-later"
homepage="https://github.com/ventureoo/PKGBUILDs"
distfiles="
 https://gitlab.winehq.org/wine/wine/-/archive/wine-${_commit}/wine-${_commit}.tar.gz
 https://gitlab.winehq.org/wine/wine-staging/-/archive/${_staging_commit}/wine-staging-${_staging_commit}.tar.gz"
checksum="
 fe0737d241ce5d86ec9869bfbc172ee515fada64f6d72d3a4b4130970e6afcf8
 1a81467699111ae18a2d70b280d41ad28d461665e79b6bef96457116ccefd2f9"

build_style=gnu-configure
configure_args="
 --disable-tests
 --with-x
 --with-wayland
 --with-gstreamer
 --with-ffmpeg
 --without-oss
 --without-sane
 --without-v4l2
 --without-cups
 --without-gphoto
 --without-xinerama
 --without-pcsclite
 --without-xxf86vm
 --without-pcap
 --with-mingw=clang
 --enable-archs=x86_64,i386"

hostmakedepends="
 git
 autoconf
 automake
 libtool
 pkg-config
 clang
 llvm
 lld
 linux-headers
 flex
 bison"

makedepends="
 alsa-lib-devel
 fontconfig-devel
 freetype-devel
 gettext-devel
 gnutls-devel
 gst-plugins-base1-devel
 libXcursor-devel
 libXi-devel
 libXrandr-devel
 libXcomposite-devel
 libxkbcommon-devel
 mesa
 opencl-headers
 ocl-icd
 SDL2-devel
 Vulkan-Headers
 vulkan-loader-devel
 wayland-devel
 ffmpeg-devel
 unixodbc-devel
 libpulseaudio"

depends="
 desktop-file-utils
 fontconfig
 freetype
 libXcursor
 libxkbcommon
 libXi
 libXrandr
 wayland
 ffmpeg
 unixodbc"

nostrip=yes
conflicts="wine>=0"
patch_args="-Np1"

do_extract() {
	mkdir -p "${wrksrc}/wine" "${wrksrc}/wine-staging"

	tar xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/wine-${_commit}.tar.gz" \
		-C "${wrksrc}/wine" --strip-components=1

	tar xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/wine-staging-${_staging_commit}.tar.gz" \
		-C "${wrksrc}/wine-staging" --strip-components=1

	cp "${FILESDIR}/30-win32-aliases.conf" "${FILESDIR}/wine-binfmt.conf" "${wrksrc}/"
}

pre_configure() {
	cd "${wrksrc}/wine"

	if [ ! -d .git ]; then
		git init
		git add -A
		git -c user.name="void" -c user.email="void@localhost" commit -m "base" --quiet
	fi

	python3 ../wine-staging/staging/patchinstall.py \
		--backend=git-apply --all \
		-W server-Signal_Thread

	local patches=(
		"0001-HACK-wine.inf-Add-native-builtin-overrides-for-msvcr.patch"
		"0002-wine.inf-Set-a-valid-Win10-ProductId.patch"
		"0003-wineboot-On-prefix-upgrade-update-win10-build-number.patch"
		"0004-wineboot-Generate-better-DigitalProductId.patch"
		"0005-wineboot-Load-root-certificates-on-prefix-update.patch"
		"Disable-optimization-of-some-functions.patch"
		"winecfg-Add-tweaks-tab-page.patch"
		"ntdll-loader-add-support-for-overriding-IMAGE_FILE_L.patch"
		"Do-not-handle-IMAGE_FILE_LARGE_ADDRESS_AWARE-on-WoW64.patch"
		"Add-workarounds-for-game-launchers.patch"
		"0001-HACK-ws2_32-Block-first-internet-connection-for-some.patch"
		"Configure-Enforce-4-byte-stack-alignment-on-clang-for-PE-builds.patch"
		"10108.patch"
		"10829.patch"
		"10864.patch"
		"kernelbase-Handle-misaligned-stack-in-OpenThread.patch"
	)

	for p in "${patches[@]}"; do
		if [ -f "${FILESDIR}/${p}" ]; then
			patch ${patch_args} -i "${FILESDIR}/${p}"
		fi
	done

	./dlls/winevulkan/make_vulkan
	./tools/make_requests
	./tools/make_specfiles
	autoreconf -f
}

do_configure() {
	export CC="clang" CXX="clang++"
	export CFLAGS="-O2 -march=x86-64-v3 -mtune=haswell -mfpmath=sse -fwrapv -pipe"
	export CXXFLAGS="${CFLAGS}"
	export CROSSCFLAGS="${CFLAGS}" CROSSCXXFLAGS="${CFLAGS}"
	export CROSSLDFLAGS="-Wl,/FILEALIGN:4096,/OPT:REF,/OPT:ICF"
	export LDFLAGS="-Wl,-O1,--sort-common,--as-needed -fuse-ld=lld"

	cd "${wrksrc}/wine"
	./configure --prefix=/usr --libdir=/usr/lib ${configure_args}
}

do_build() {
	cd "${wrksrc}/wine"
	make ${makejobs}
}

do_install() {
	cd "${wrksrc}/wine"
	make DESTDIR="${DESTDIR}" install

	ln -sf wine "${DESTDIR}/usr/bin/wine64"

	llvm-strip --strip-unneeded \
		"${DESTDIR}/usr/lib/wine/i386-windows/"*.{dll,exe} \
		"${DESTDIR}/usr/lib/wine/x86_64-windows/"*.{dll,exe} 2>/dev/null || true

	vmkdir usr/share/fontconfig/conf.avail
	vmkdir usr/share/fontconfig/conf.default
	vinstall "${wrksrc}/30-win32-aliases.conf" 644 usr/share/fontconfig/conf.avail
	ln -s ../conf.avail/30-win32-aliases.conf \
		"${DESTDIR}/usr/share/fontconfig/conf.default/30-win32-aliases.conf"

	vinstall "${wrksrc}/wine-binfmt.conf" 644 usr/lib/binfmt.d wine.conf

	vmkdir usr/lib/modules-load.d
	echo "ntsync" > "${DESTDIR}/usr/lib/modules-load.d/wine-pure.conf"
}
