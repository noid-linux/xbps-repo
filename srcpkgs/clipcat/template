# Template file for 'clipcat'
pkgname=clipcat
version=0.27.0
revision=1
archs="x86_64"
build_style=cargo
hostmakedepends="pkg-config protobuf"
makedepends="libgit2-1.9-devel protobuf-devel"
short_desc="Clipboard Manager written in Rust Programming Language"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="GPL-3.0-only"
homepage="https://github.com/xrelkd/clipcat"
distfiles="https://github.com/xrelkd/clipcat/archive/refs/tags/v${version}.tar.gz"
checksum=0b6835c923beb45429cb10fa9eeddff423ef51f2434634cbd58366f402bbf42f

do_install() {
	: ${make_cmd:=cargo auditable}
	: ${make_verbose:=-v}

	# TODO: probably should make these into subpackages
	for pkg in clipcatd clipcatctl clipcat-menu clipcat-notify; do
		${make_cmd} install ${XBPS_VERBOSE+${make_verbose}} --target ${RUST_TARGET} --root="${DESTDIR}/usr" \
					--offline --locked ${configure_args} --path ${pkg}
	done

	rm -f "${DESTDIR}"/usr/.crates.toml
	rm -f "${DESTDIR}"/usr/.crates2.json
}
