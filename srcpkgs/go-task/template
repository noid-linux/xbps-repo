post_install() {
	mv ${DESTDIR}/usr/bin/task ${DESTDIR}/usr/bin/go-task

	vcompletion completion/bash/task.bash bash
	vcompletion completion/fish/task.fish fish
	vcompletion completion/zsh/_task zsh

	vlicense LICENSE
}
