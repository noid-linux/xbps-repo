# Template file for 'distrobox'
pkgname=distrobox
version=1.8.2.6
revision=1
archs="x86_64"
depends="bash"
short_desc="Use any linux distribution inside your terminal"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="GPL-3.0-only"
homepage="https://distrobox.it/"
changelog="https://github.com/89luca89/distrobox/releases"
