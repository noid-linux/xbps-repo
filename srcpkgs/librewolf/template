# Template file for 'librewolf'
pkgname=librewolf
version=158.0.1.2
revision=1
_version="${version%.*}-${version##*.}"
archs="x86_64"
depends="desktop-file-utils hicolor-icon-theme pciutils"
short_desc="Fork of Firefox, focused on privacy, security and freedom"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="MPL-2.0"
homepage="https://librewolf.net/"
_base_url="https://codeberg.org/api/packages/librewolf/generic/librewolf/${_version}"
distfiles="${_base_url}/librewolf-${_version}-linux-x86_64-package.tar.xz
 https://codeberg.org/librewolf/source/archive/${_version}.tar.gz"
checksum="de1522759855e849ba09839749e3871aa06820a2ce1418be4099ce388a93ef02
 2716fb3422a4fbe6f123704980afe050daa587b16c19731d69a3fb6e7096db00"
skip_extraction="${_version}.tar.gz"

post_extract() {
	vsrcextract -C source "${_version}.tar.gz"
}

do_install() {
	vmkdir usr/lib/${pkgname}
	vcopy * usr/lib/${pkgname}/
	rm -rf ${DESTDIR}/usr/lib/${pkgname}/source

	vmkdir usr/bin
	ln -sf /usr/lib/${pkgname}/${pkgname} ${DESTDIR}/usr/bin/${pkgname}

	vinstall ${FILESDIR}/vendor.js 644 usr/lib/librewolf/browser/defaults/preferences/
	vinstall ${FILESDIR}/${pkgname}.desktop 644 usr/share/applications/

	for i in 16 32 48 64 128; do
		vmkdir usr/share/icons/hicolor/${i}x${i}/apps
		vcopy source/themes/browser/branding/librewolf/default${i}.png \
			usr/share/icons/hicolor/${i}x${i}/apps/librewolf.png
	done
}
