# Template file for 'ferdium'
pkgname=ferdium
version=7.2.2
revision=1
_electronver=35
archs="x86_64"
build_wrksrc="ferdium-app-${version}"
hostmakedepends="pnpm git"
makedepends="electron${_electronver}-devel"
depends="electron${_electronver}"
short_desc="Desktop app bringing all your messaging services into one installable"
maintainer="Naz <ndpm13@ch-naseem.com>"
license="Apache-2.0"
homepage="https://ferdium.org/"
changelog="https://raw.githubusercontent.com/ferdium/ferdium-app/refs/heads/develop/CHANGELOG.md"
distfiles="https://github.com/ferdium/ferdium-app/archive/refs/tags/v${version}.tar.gz>${pkgname}-v${version}.tar.gz
 https://github.com/ferdium/ferdium-recipes/archive/refs/heads/main.tar.gz>recipes.tar.gz"
checksum="ca5878ba00775096aae18c283b9d30701fc41443f237a91f9d821bfcf185272c
 02b85e00bf4368b2f9620e48acc2ffcc5067b4ef2f9b8fbd52e5a2068e261774"

post_extract() {
	mv ferdium-recipes-main/* ${build_wrksrc}/recipes
}

pre_build() {
	cd recipes
	pnpm i --frozen-lockfile
	pnpm package

	cd ..
	pnpm i --frozen-lockfile
	pnpm prepare-code
}

do_build() {
	pnpm build --x64 --linux --dir \
		-c.electronVersion="$(cat /usr/lib/electron${_electronver}/version)" \
		-c.electronDist="/usr/lib/electron${_electronver}"
}

do_install() {
	vmkdir usr/lib/${pkgname}
	vcopy out/linux-unpacked/resources usr/lib/${pkgname}

	sed "s/@electronver@/${_electronver}/g" ${FILESDIR}/${pkgname}.sh > ${TMPDIR}/${pkgname}.sh
	vbin ${TMPDIR}/${pkgname}.sh ${pkgname}

	vinstall ${FILESDIR}/${pkgname}.desktop 644 usr/share/applications
	vinstall build-helpers/images/icon.png 644 usr/share/pixmaps ${pkgname}.png

	rm -f ${DESTDIR}/usr/lib/ferdium/resources/app-update.yml
}
